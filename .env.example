# Data Lake (MinIO) settings
DATA_LAKE_ACCESS_KEY_ID=admin
DATA_LAKE_SECRET_ACCESS_KEY=admin123
DATA_LAKE_ENDPOINT=http://minio:9000

# Kafka settings
KAFKA_BOOTSTRAP_SERVERS=broker:29092
KAFKA_TOPIC_BUSINESS=raw_data_business
KAFKA_TOPIC_REVIEW=raw_data_review
KAFKA_TOPIC_USER=raw_data_user
KAFKA_STARTING_OFFSETS=latest
# Suggested (enriched stream, local): smaller batches to avoid long joins
# KAFKA_MAX_OFFSETS_PER_TRIGGER=200
# KAFKA_TRIGGER_SECONDS=5
KAFKA_API_URL=http://localhost:8010/api/kafka/publish
SERVING_API_URL=http://localhost:8010/api
KAFKA_CONNECT_BRONZE_FLUSH_SIZE=10
KAFKA_CONNECT_REST_PORT=8083

# Airflow basic settings
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.3
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=./apps/batch/airflow

# Airflow Admin credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Airflow Optional: extra Python packages
_PIP_ADDITIONAL_REQUIREMENTS=pymongo==4.6.3

# Grafana credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123

# MongoDB settings
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=password
MONGO_DB=yelp
MONGO_AUTH_DB=admin
MONGO_COLLECTION_USER=users
MONGO_COLLECTION_BUSINESS=businesses
MONGO_COLLECTION_REVIEW=reviews
MONGO_COLLECTION_REVIEWS_ENRICHED=reviews_enriched

# Streaming checkpoints (override per service as needed)
KAFKA_REVIEWS_CHECKPOINT=/tmp/reviews_checkpoint
KAFKA_REVIEWS_ENRICHED_CHECKPOINT=/tmp/reviews_enriched_checkpoint
KAFKA_USERS_CHECKPOINT=/tmp/users_checkpoint
KAFKA_BUSINESSES_CHECKPOINT=/tmp/businesses_checkpoint

# Postgres settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=analytics

# ClickHouse settings
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse123
CLICKHOUSE_DB=analytics

# Spark settings
SPARK_REST_URL=http://spark-master:6066
SPARK_SHUFFLE_PARTITIONS=8
